{
  "name": "optimized-node-app",
  "version": "1.0.0",
  "description": "High-performance Node.js application with optimizations",
  "main": "src/app.js",
  "type": "module",
  "scripts": {
    "start": "node --max-old-space-size=4096 src/app.js",
    "dev": "node --inspect --max-old-space-size=4096 src/app.js",
    "prod": "NODE_ENV=production node --max-old-space-size=4096 --optimize-for-size src/app.js",
    "benchmark": "node src/benchmark.js",
    "test": "node --test src/**/*.test.js",
    "lint": "eslint src/",
    "profile": "node --prof src/app.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "express": "^4.18.2",
    "compression": "^1.7.4",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "rate-limiter-flexible": "^3.0.8",
    "redis": "^4.6.10",
    "ioredis": "^5.3.2",
    "cluster": "^0.7.7",
    "pm2": "^5.3.0",
    "dotenv": "^16.3.1",
    "winston": "^3.11.0",
    "pino": "^8.17.2",
    "fastify": "^4.24.3"
  },
  "devDependencies": {
    "eslint": "^8.55.0",
    "nodemon": "^3.0.2",
    "autocannon": "^7.15.0",
    "clinic": "^12.0.0",
    "0x": "^5.7.0"
  },
  "keywords": [
    "nodejs",
    "performance",
    "optimization",
    "high-performance",
    "scalable"
  ],
  "author": "Your Name",
  "license": "MIT"
}